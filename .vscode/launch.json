    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/build/compiler",
            "args": [
                "tests/if_stmt.comp",
                "-o",
                "build/if_stmt.out"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build",
        }
    ]
}